# Copy to .env (docker compose reads it automatically) to override defaults.

# Which probe-cli ref to build miniooni from. Used for testing a matrix of
# client versions - point this at a tag (e.g. v3.24.0) or a PR branch.
PROBE_CLI_REPO=https://github.com/ooni/probe-cli.git
PROBE_CLI_REF=master

# Host port the nginx router is published on.
ROUTER_PORT=8080

# Override if you've built the service images with a different tag than
# the default `ooni-e2e/<service>:e2e` produced by scripts/build-images.sh.
# OONIAUTH_IMAGE=ooni-e2e/ooniauth:e2e
# OONIFINDINGS_IMAGE=ooni-e2e/oonifindings:e2e
# OONIMEASUREMENTS_IMAGE=ooni-e2e/oonimeasurements:e2e
# OONIPROBE_IMAGE=ooni-e2e/ooniprobe:e2e
# OONIRUN_IMAGE=ooni-e2e/oonirun:e2e
# TESTLISTS_IMAGE=ooni-e2e/testlists:e2e
